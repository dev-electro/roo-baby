# ── Google Analytics 4 ──
# Leave empty to disable. Get your ID at https://analytics.google.com
# PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Cloudflare R2 Audio Storage ──
# Public R2 bucket URL for hosting soothing audio files (.m4a)
# Leave empty to use Web Audio synthesis only (no files needed)
# PUBLIC_R2_BASE=https://pub-YOUR_BUCKET.r2.dev

# ── Provider 1: Google Gemini API (primary, recommended) ──
# Get your key at https://aistudio.google.com/apikey
# Higher rate limits, direct access to Gemma 4 models
GEMINI_API_KEY=your-gemini-key-here

# Model ID for Gemini
GEMINI_MODEL=gemma-4-31b-it

# ── Provider 2: OpenRouter API (fallback) ──
# Get your key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# OpenRouter model ID
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# ── Site URL (for fetching atlas reference images) ──
SITE_URL=https://roo-baby.pages.dev
