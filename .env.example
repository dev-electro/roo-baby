# ── OpenRouter API (required) ──
# Get your key at https://openrouter.ai/settings/keys
# Deposit $10+ for higher rate limits on free endpoints
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ── Model Selection (optional, defaults shown) ──
# Audio-only and Image-only modes → cheaper, faster model
MODEL_SINGLE=google/gemma-4-26b-a4b-it:free

# Both mode (audio+image cross-reference) → bigger brain for complex reasoning
MODEL_BOTH=google/gemma-4-31b-it:free

# Fallback when primary model is rate-limited (429)
MODEL_FALLBACK=google/gemma-4-31b-it:free

# ── Site URL (for fetching atlas reference images) ──
SITE_URL=https://roo-baby.pages.dev