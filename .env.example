# Required: Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Model for analysis. Only E2B/E4B support native audio on-device.
# For cloud API: use gemini-2.0-flash (audio+image) or gemma-4-26b-a4b-it (image only)
GEMINI_MODEL_NAME=gemini-2.0-flash
