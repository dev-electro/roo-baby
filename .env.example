# ── Google Gemini API (primary, recommended) ──
# Get your key at https://aistudio.google.com/apikey
# Higher rate limits, direct access to Gemma 4 models
GEMINI_API_KEY=your-gemini-key-here

# Gemini model IDs (these are the direct model names, not OpenRouter IDs)
GEMINI_MODEL_SINGLE=gemma-4-26b-a4b-it
GEMINI_MODEL_BOTH=gemma-4-31b-it

# ── OpenRouter API (fallback) ──
# Get your key at https://openrouter.ai/settings/keys
# Deposit $10+ for higher rate limits on free endpoints
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ── OpenRouter Model Selection (optional, defaults shown) ──
# Audio-only and Image-only modes → cheaper, faster model
MODEL_SINGLE=google/gemma-4-26b-a4b-it:free

# Both mode (audio+image cross-reference) → bigger brain
MODEL_BOTH=google/gemma-4-31b-it:free

# Fallback when primary model is rate-limited (429)
MODEL_FALLBACK=google/gemma-4-31b-it:free

# ── Site URL (for fetching atlas reference images) ──
SITE_URL=https://roo-baby.pages.dev